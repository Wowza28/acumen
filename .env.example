# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_SMART_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Optional chat providers (shown in the chat model dropdown when configured) ---
# Gemini appears as "Gemini" when the key is set
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Ordered fallbacks used when a Gemini model is rate-limited (429) or unavailable.
# Defaults already cover flash -> flash-lite; add your own (e.g. a pro variant) here.
GEMINI_FALLBACKS=
# Local Ollama appears as the model name (e.g. qwen2.5:7b) when set
OLLAMA_MODEL=
OLLAMA_URL=http://localhost:11434/v1

# --- DB (SQLite local, switch to postgres by changing provider + url) ---
DATABASE_URL="file:./dev.db"

# --- Titan Mail + Calendar (read-only sync: IMAP + CalDAV) ---
TITAN_EMAIL=you@yourdomain.com
TITAN_PASSWORD=your-titan-password
# IMAP (default matches Titan docs; override only if your account differs)
TITAN_IMAP_HOST=imap.titan.email
# CalDAV base (EU accounts: https://dav-eu.titan.email)
TITAN_CALDAV_URL=https://dav.titan.email
# Optional: full calendar collection URL from your CalDAV client config
# (skips CalDAV discovery if the automatic path guesses wrong)
TITAN_CALDAV_CAL_URL=
# Mail sync: batch size (probed cheaply) and how many batches each sync walks back.
# Only new messages are downloaded, so larger values are safe (just slower probing).
TITAN_MAIL_LIMIT=100
TITAN_SYNC_MAX_BATCHES=3
TITAN_CAL_DAYS_PAST=30
TITAN_CAL_DAYS_FUTURE=60


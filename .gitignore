# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output & cache
.next/
out/
build/
dist/
.cache/

# User data, database & uploads (never commit private CRM data)
*.db
*.db-journal
*.db-wal
*.db-shm
prisma/*.db*
uploads/*
!uploads/.gitkeep
# Docker bind-mount data (./data next to compose.yaml): structure is tracked,
# contents never are. (Trailing "/*" keeps the .gitkeep markers addable while
# ignoring real db/upload files.)
data/db/*
!data/db/.gitkeep
data/uploads/*
!data/uploads/.gitkeep
!data/.gitkeep

# Environment files & secrets
.env
.env*.local
.env.production
.env.staging

# Logs and scratch files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tmp-*
patch1.py

# System & IDE files
.DS_Store
*.pem
.vscode/
.idea/
*.tsbuildinfo
